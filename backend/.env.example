# ==============================================================================
# INVOICE GENERATOR PRO — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your real values.
# DO NOT commit your .env file to Git!
# ==============================================================================

# Server Port
PORT=5000

# MongoDB Connection String (Atlas or Local)
# IMPORTANT: Ensure your Atlas IP Access List allows 0.0.0.0/0 for Render deployment
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/invoicedb?retryWrites=true&w=majority

# Frontend URL (used for payment link generation and OAuth callbacks)
# Local: http://localhost:5173 | Production: https://your-frontend-url.vercel.app
FRONTEND_URL=http://localhost:5173

# Authentication & Session Secrets
JWT_SECRET=your_super_secret_jwt_key_here
SESSION_SECRET=your_super_secret_session_key_here

# Google OAuth 2.0 Credentials (for Sign-In with Google and OAuth email sending)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Gmail SMTP Fallback Credentials (for standard email delivery)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password

# Razorpay Payment Gateway Credentials (TEST MODE ONLY — never commit live keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Gemini Vision OCR (for automated AI receipt & invoice scanning)
# Free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Optional: Puppeteer Chrome Executable Path (configured automatically in Dockerfile)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
